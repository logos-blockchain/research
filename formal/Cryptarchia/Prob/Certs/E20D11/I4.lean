theorem postS4_0 : AutoSol f0 11 (xg (1471 / 1250 : ℝ) (15901 / 10000 : ℝ) (2619 / 2500 : ℝ) (889 / 1250 : ℝ) (51 / 50 : ℝ) 4).1 (xg (1471 / 1250 : ℝ) (15901 / 10000 : ℝ) (2619 / 2500 : ℝ) (889 / 1250 : ℝ) (51 / 50 : ℝ) 4).2.1 (xg (1471 / 1250 : ℝ) (15901 / 10000 : ℝ) (2619 / 2500 : ℝ) (889 / 1250 : ℝ) (51 / 50 : ℝ) 4).2.2 post4_0 := by
  rw [xg_4]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, post4_0]

theorem maxp4_0 : ∀ q < 11, ∀ a u, post4_0 q a u ≤ vmax4 q a u := by
  intro q hq a u; interval_cases q <;> fin_cases a <;> cases u <;> norm_num [post4_0, vmax4]

