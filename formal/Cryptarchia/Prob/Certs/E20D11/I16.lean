def post16Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X16 SZ (gFloorZ X16 SZ) (postTop16 k)
def pre16Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X16 SZ vmax16Z (preTop16 k)

/-- Every check of member `k`, as one Boolean. -/
def chkE16Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X16 SZ (post16Z k) && leTabZ 11 (post16Z k) vmax16Z &&
    preSolZ (famZ k) DZ 11 X16 SZ vmax16Z (pre16Z k) &&
    decide ((autoBoundZ (famZ k) DZ X16 SZ (post16Z k) : ℚ) ≤ eIn16 k * (X16.M DZ * SZ : ℤ)) &&
    decide ((autoBoundZ (famZ k) DZ X16 SZ (pre16Z k) : ℚ) ≤ (219538222731 / 20000000000000 : ℚ) * (X16.M DZ * SZ : ℤ))

