theorem postS16_0 : AutoSol f0 11 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 16).1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 16).2.1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 16).2.2 post16_0 := by
  rw [xg_16]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, post16_0]

theorem maxp16_0 : ∀ q < 11, ∀ a u, post16_0 q a u ≤ vmax16 q a u := by
  intro q hq a u; interval_cases q <;> fin_cases a <;> cases u <;> norm_num [post16_0, vmax16]

theorem preS16_0 : PreSol f0 11 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 16).1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 16).2.1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 16).2.2 vmax16 pre16_0 := by
  rw [xg_16]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, pre16_0, vmax16]

