/-- The switching table, from its entries at `(0, a, true)`. -/
def vs1Z : ℕ → Fin 3 → Bool → ℤ :=
  fillAllZ ((List.finRange 32).map famZ) DZ 11 X1 SZ (fun _ _ _ => 0) ![18936715550765508552, 18936715550765508552, 18936715550765508552]

theorem chkS1 : ∀ k, (autoSolZ (famZ k) DZ 11 X1 SZ vs1Z &&
    decide ((autoBoundZ (famZ k) DZ X1 SZ vs1Z : ℚ) ≤ (1002940643911 / 1000000000000 : ℚ) * (X1.M DZ * SZ : ℤ))) = true := by
