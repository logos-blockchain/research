theorem postS18_0 : AutoSol f0 11 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).2.1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).2.2 post18_0 := by
  rw [xg_18]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, post18_0]

theorem maxp18_0 : ∀ q < 11, ∀ a u, post18_0 q a u ≤ vmax18 q a u := by
  intro q hq a u; interval_cases q <;> fin_cases a <;> cases u <;> norm_num [post18_0, vmax18]

theorem preS18_0 : PreSol f0 11 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).2.1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).2.2 vmax18 pre18_0 := by
  rw [xg_18]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, pre18_0, vmax18]

theorem heE18_0 : autoBound f0 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).2.1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 18).2.2 pre18_0 ≤ (500000000003 / 500000000000 : ℝ) := by
