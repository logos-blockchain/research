theorem postS6_0 : AutoSol f0 11 (xg (1471 / 1250 : ℝ) (15901 / 10000 : ℝ) (2619 / 2500 : ℝ) (889 / 1250 : ℝ) (51 / 50 : ℝ) 6).1 (xg (1471 / 1250 : ℝ) (15901 / 10000 : ℝ) (2619 / 2500 : ℝ) (889 / 1250 : ℝ) (51 / 50 : ℝ) 6).2.1 (xg (1471 / 1250 : ℝ) (15901 / 10000 : ℝ) (2619 / 2500 : ℝ) (889 / 1250 : ℝ) (51 / 50 : ℝ) 6).2.2 post6_0 := by
  rw [xg_6]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, post6_0]

theorem maxp6_0 : ∀ q < 11, ∀ a u, post6_0 q a u ≤ vmax6 q a u := by
  intro q hq a u; interval_cases q <;> fin_cases a <;> cases u <;> norm_num [post6_0, vmax6]

