/-- Every check of member `k`, as one Boolean. -/
def chkE13Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X13 SZ (post13Z k) && leTabZ 11 (post13Z k) vmax13Z &&
    preSolZ (famZ k) DZ 11 X13 SZ vmax13Z (pre13Z k) &&
    decide ((autoBoundZ (famZ k) DZ X13 SZ (post13Z k) : ℚ) ≤ eIn13 k * (X13.M DZ * SZ : ℤ)) &&
