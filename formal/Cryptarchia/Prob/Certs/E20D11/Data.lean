module

public import Cryptarchia.Prob.Certs.E20D11.Params
meta import Cryptarchia.Prob.Certs.E20D11.Params

/-!
# E20D11: the computed data

Generated by `tools/certgen/emitF.py`. The band family: Lean computes each member's band from its
breakpoints (`memberOfQ`) and the kernel checks it (`famOK`). The phase indices are in `I<g>.lean`,
a few per file: each index's tables are given by their seeds, which Lean computes at elaboration
time (`eval%`), with the bounds they give; the kernel checks each index (`chk<i>`, `FamCfg.idxChk`).
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The family's integer bands and the potential's parameters. -/
def F : FamCfg where
  toPotCfg := pot                 -- the potential's parameters
  S := S                          -- the band family
  famZL := eval% S.famZList S.DZ  -- the members' integer bands, computed once
  D := eval% S.DZ                 -- their common denominator

theorem famOK : F.S.chk F.famZ F.D = true := by decide +kernel

theorem dOK : 0 < F.D := by decide +kernel

end Cryptarchia.Prob.Certs.E20D11
