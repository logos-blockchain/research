def post3Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X3 SZ (gFloorZ X3 SZ) (postTop3 k)
def pre3Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X3 SZ vmax3Z (preTop3 k)

/-- Every check of member `k`, as one Boolean. -/
def chkE3Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X3 SZ (post3Z k) && leTabZ 11 (post3Z k) vmax3Z &&
    preSolZ (famZ k) DZ 11 X3 SZ vmax3Z (pre3Z k) &&
    decide ((autoBoundZ (famZ k) DZ X3 SZ (post3Z k) : ℚ) ≤ eIn3 k * (X3.M DZ * SZ : ℤ)) &&
    decide ((autoBoundZ (famZ k) DZ X3 SZ (pre3Z k) : ℚ) ≤ (9993982974269 / 10000000000000 : ℚ) * (X3.M DZ * SZ : ℤ))

