        (σE (E.withO (O ω)) (es ω) (n + 1))} := by
  have hEL : E.c.epochLength = 648000 := by rw [hc]; rfl
  refine (final_bimm_ro_epoch3_ok (M := 31542119) hA es hNF hdel hO hσm hfresh hΔ (D3 E.c.epochLength hEL)
