    (hdel : ∀ ω, DeltaDelivery (E.withO (O ω)) (es ω)) (hO : RandomOracle μ O E.c.p)
    (hσm : ∀ i, Measurable fun ω => σE (E.withO (O ω)) (es ω) i)
    (hfresh : Fresh μ O fun ω => σE (E.withO (O ω)) (es ω))
    (hband : ∀ ω i, 1 ≤ i → i ≤ 650919 → SlotBand B E i (σE (E.withO (O ω)) (es ω) i)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (1 / 1000000000000000000000 : ℝ) :=
  (final_bimm_ro (M := 650919) hA es hNF hdel hO hσm hfresh hΔ P hBs
    (fun ω i h1 h2 => ⟨B, List.mem_singleton_self B, hband ω i h1 h2⟩) (G := 165) (G' := 2912) (J := 42982) (Lw := 50500)
    (r := 484) (T := 24) (x := (259 / 200 : ℝ)) (yy := (11 / 20 : ℝ)) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
