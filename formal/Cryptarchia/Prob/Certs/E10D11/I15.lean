theorem postS15_0 : AutoSol f0 11 (xg (7023 / 5000 : ℝ) (24363 / 10000 : ℝ) (10199 / 10000 : ℝ) (4211 / 5000 : ℝ) (103 / 100 : ℝ) 15).1 (xg (7023 / 5000 : ℝ) (24363 / 10000 : ℝ) (10199 / 10000 : ℝ) (4211 / 5000 : ℝ) (103 / 100 : ℝ) 15).2.1 (xg (7023 / 5000 : ℝ) (24363 / 10000 : ℝ) (10199 / 10000 : ℝ) (4211 / 5000 : ℝ) (103 / 100 : ℝ) 15).2.2 post15_0 := by
  rw [xg_15]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, post15_0]

theorem maxp15_0 : ∀ q < 11, ∀ a u, post15_0 q a u ≤ vmax15 q a u := by
  intro q hq a u; interval_cases q <;> fin_cases a <;> cases u <;> norm_num [post15_0, vmax15]

