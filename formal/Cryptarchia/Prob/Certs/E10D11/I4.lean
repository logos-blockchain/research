  rw [xg_4]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, post4_0]

theorem maxp4_0 : ∀ q < 11, ∀ a u, post4_0 q a u ≤ vmax4 q a u := by
  intro q hq a u; interval_cases q <;> fin_cases a <;> cases u <;> norm_num [post4_0, vmax4]

