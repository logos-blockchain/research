/-!
# Finality certificate with a table potential: β = 1/5, Δ = 11, k = 1000

Generated by `tools/certgen/emitT.py`. The specification's parameters with security parameter
k = 1000 (f = 1/30) are `Config.specK 1000`'s. The failed checks are bounded by a table potential
(`Prob/Table.lean`) instead of the two-term exponential one. The certificate is the data below; Lean
computes the rest and the kernel checks it (`TableCert.lean`, `TableSpec.lean`):

- the chosen numbers (`Params.lean`) and the family's integer bands (`Data.lean`), as for the other
  certificates, with the potential's second term off (`κ = 0`);
- the switching tables of the reach, the checked phase and spans (`Sw.lean`);
- the table (`Tab.lean`), and each representative state's terminal table and one-switch tables
  (`R<j>.lean`);
- the derived numbers `der` (`SpecData.deriveL`): the table's contractions by rule (`tabLp`, `tabLpi`),
  the settlement parameters by rule, and the bounds on settlement, on leaving the band in one epoch and
  on a finality violation;
- the checks of the reach potential (`c2OK`), the table (`tabOK`) and every numeric condition (`finOK`).
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11T

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The phase indices' data: the switching tables of indices 0, 1, 2, 17; the others take no part. -/
def datZ : IdxData := ⟨[], [], [], 0, [], 0⟩

def dat : Fin 19 → IdxData := ![dat0, dat1, dat2, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, dat17, datZ]

theorem swOK : ∀ i : Fin 19, FamCfg.isSw i = true → F.idxChkSw i (dat i) = true := by
  intro i; fin_cases i
  exacts [fun _ => sw0, fun _ => sw1, fun _ => sw2, fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun _ => sw17, fun h => absurd h (by decide)]

/-- The representatives, in chunks. -/
def D : Fin 24 → List ((ℤ × ℤ) × RepData) := ![D0, D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12, D13, D14, D15, D16, D17, D18, D19, D20, D21, D22, D23]

theorem tabA : F.tabChkA Q D := by
  intro j; fin_cases j
  exacts [chkA0, chkA1, chkA2, chkA3, chkA4, chkA5, chkA6, chkA7, chkA8, chkA9, chkA10, chkA11, chkA12, chkA13, chkA14, chkA15, chkA16, chkA17, chkA18, chkA19, chkA20, chkA21, chkA22, chkA23]

/-- The derived numbers (`SpecData.deriveL`), with the table's contractions by rule. -/
def der : SpecDerived := eval% par.deriveL F F.S.weakest dat Tq (F.tabLp Q F.S.weakest D) (F.tabLpi Q D)

theorem derNe : der.Ne = 18 := by decide +kernel

theorem derFin : der.fin = (3 / 2000 : ℚ) := by decide +kernel

/-- Derived by Lean: (18, 3 / 2000, 4997870734449 / 5000000000000, 4986087543513 / 5000000000000, 1 / 4000, 1641 / 25000000, 15419, 8266,
  341, 1192, 100, 34) -/
theorem c2OK : cert2ChkQ F.S.weakest F.Δ F.c F.z F.s 0 F.d F.τ 0 (FamCfg.lrOf dat) (FamCfg.bOf dat) (FamCfg.eOf dat) = true := by
  decide +kernel

theorem tabOK : F.tabChk Q F.S.weakest der.lp der.lpi D = true := by decide +kernel

theorem finOK : FamCfg.finChkSpec F F.S.weakest dat Tq par der = true := by decide +kernel

/-- **Finality, certified** (`Claim.Finality`): f = 1/30, k = 1000, Δ = 11 slots, executions up to
slot 5184000; the adversary holds at most 0.2 of the participating stake, stakes are at most
10³⁰, the canonical chain counts at least 0.87 of each window's honestly won slots,
stake drifts by at most a factor 1.01 per epoch and honest online stake is at least
1000000; a finality violation has probability at most 1.50e-03. -/
theorem finality :
    Claim.Finality (k := 1000) (Δ := 11) (N := 5184000) (β := (1 / 5 : ℝ)) (Smax := 10 ^ 30) (μ := (13 / 100 : ℝ))
      (ρ := (101 / 100 : ℝ)) (Hmin := (1000000 : ℝ)) (ε := (3 / 2000 : ℝ)) := by
  intro Ω _ μ _ O E es hM hc hΔ hN hG hS hQ hD hH
  have hT : Tq.β = (1 / 5 : ℚ) ∧ Tq.ζ = 1 / 10 ^ 16 ∧ Tq.μ = (13 / 100 : ℚ) := by decide +kernel
  have h := FamCfg.finality_specT F par der c2OK famOK dOK rfl swOK tabOK tabA tiesOK rfl Tq finOK (by rw [hc]; rfl)
    hΔ es hM hN (Smax := 10 ^ 30) (by rw [hT.2.1]; decide +kernel) (by rw [derNe]; decide +kernel) hG
    (fun ω => by rw [hT.1]; simpa using hS ω) (fun ω => by rw [hT.2.2]; simpa [par] using hQ ω)
    (fun ω => by simpa [par] using hD ω) (fun ω => by simpa [par] using hH ω)
  rw [derFin] at h
  simpa using h

end Cryptarchia.Prob.Certs.E20D11T
