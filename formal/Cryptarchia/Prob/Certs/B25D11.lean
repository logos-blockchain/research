  (final_bimm_ro (M := 650754) hA es hNF hdel hO hσm hfresh hΔ P hBs
    (fun ω i h1 h2 => ⟨B, List.mem_singleton_self B, hband ω i h1 h2⟩) (G := 561) (G' := 2741) (J := 34497) (Lw := 50500)
