/-- **Certified multi-epoch finality from a random oracle.** β = 0.2, Δ = 11,
k = 2160, executions up to slot 31536000. Random-oracle tickets, fresh lotteries, Δ-delivery;
`pick` assigns each epoch and state a member. A finality violation has probability at most
`9/10000000000000` plus the probability that some slot's state is outside its member's band. -/
theorem certified {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) (hc : E.c = Config.spec) (hΔ : E.Δ = 11)
    (hA : Assm E) (es : Ω → List Event) (hNF : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ 31536000)
    (hdel : ∀ ω, DeltaDelivery (E.withO (O ω)) (es ω)) (hO : RandomOracle μ O E.c.p)
    (hσm : ∀ i, Measurable fun ω => σE (E.withO (O ω)) (es ω) i)
    (hfresh : Fresh μ O fun ω => σE (E.withO (O ω)) (es ω)) (pick : ℕ → EpochState → Fin 32) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (9 / 10000000000000 : ℝ) +
      μ {ω | ∃ n < 31539219, ¬ SlotBand (fam (pick ((n + 1) / E.c.epochLength) (σE (E.withO (O ω)) (es ω) (n + 1))))
        E (n + 1)
        (σE (E.withO (O ω)) (es ω) (n + 1))} := by
  have hEL : E.c.epochLength = 648000 := by rw [hc]; rfl
  refine (final_bimm_ro_epoch3_ok (M := 31539219) hA es hNF hdel hO hσm hfresh hΔ (D3 E.c.epochLength hEL)
    (fun k => by fin_cases k; exacts [prod0, prod1, prod2, prod3, prod4, prod5, prod6, prod7, prod8, prod9, prod10, prod11, prod12, prod13, prod14, prod15, prod16, prod17, prod18, prod19, prod20, prod21, prod22, prod23, prod24, prod25, prod26, prod27, prod28, prod29, prod30, prod31]) pick
    (G' := 2436) (J := 19166) (Lw := 34668) (r := 455) (T := 20) (x := (6251 / 5000 : ℝ)) (yy := (1587 / 2500 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by rw [hEL]; norm_num)).trans
    (add_le_add (ENNReal.ofReal_le_ofReal (eps_le E hc)) le_rfl)


