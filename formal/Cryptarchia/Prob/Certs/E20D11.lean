/-!
# Multi-epoch finality certificate: β = 1/5, Δ = 11, k = 2160, 32 members

Generated by `tools/certgen/emitF.py`. The certificate is the data below; Lean computes the rest
and the kernel checks it (`CertGen.lean`, `CertSpec.lean`):

- the band family, the potential's parameters and each phase index's tables (`Data.lean`);
- the chosen numbers `par`: the potential's `κ`, contractions `lp` and `lpi`, the settlement
  parameters and the bounds on settlement (`8.60e-11`), on leaving the band in one epoch
  (`2.343e-14`) and on a finality violation; and the estimate's band `Tq`;
- the checks of the potential (`mainOK`) and of every numeric condition (`finOK`).
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The phase indices' data. -/
def dat : Fin 19 → IdxData := ![dat0, dat1, dat2, dat3, dat4, dat5, dat6, dat7, dat8, dat9, dat10, dat11, dat12, dat13, dat14, dat15, dat16, dat17, dat18]

theorem idxOK : ∀ i : Fin 19, F.idxChk i (dat i) = true := by
  intro i; fin_cases i
  exacts [chk0, chk1, chk2, chk3, chk4, chk5, chk6, chk7, chk8, chk9, chk10, chk11, chk12, chk13, chk14, chk15, chk16, chk17, chk18]

/-- The certificate's chosen numbers. -/
def par : SpecData where
  κ := (1161 / 10000 : ℚ)                     -- the weight of the cold potential's second term
  lp := (9993122321859 / 10000000000000 : ℚ)  -- the potential's contraction per phase
  lpi := (1247304775463 / 1250000000000 : ℚ)  -- its contraction per phase inside an epoch
  N := 31536000                               -- the horizon: executions up to slot N
  M := 31538996                               -- the slots the analysis covers, N + G + G' + Δ + 2
  Ne := 49                                    -- the epochs they span
  G := 737                                    -- the phase cut: longer phases count as failures
  G' := 2246                                  -- the longest empty run
  J := 18473                                  -- the phases of a span
  Lw := 33871                                 -- the slots of a span, and of a crowded window
  r := 462                                    -- the reach bound
  T := 22                                     -- the growth block, in slots
  x := (3091 / 2500 : ℚ)                      -- the crowded-window tilt
  yy := (947 / 1250 : ℚ)                      -- the slow-growth tilt
  ρ := (101 / 100 : ℚ)                        -- the stake drift per epoch (`StakeDrift`)
  Hmin := (1000000 : ℚ)                       -- the least honest online stake (`MinStake`)
  tgt := (43 / 500000000000 : ℚ)              -- the bound on settlement failing, 8.60e-11
  bx := (2343 / 100000000000000000 : ℚ)       -- the bound on leaving the band in one epoch, 2.343e-14
  fin := (11 / 125000000000 : ℚ)              -- the bound on a finality violation, 8.80e-11

/-- The estimate's band: `λV/D ∈ [ℓlo, ℓhi]`, μ = 13/100, β = 1/5, δ = 17/200. -/
def Tq : TBandQ where
  ℓlo := (30111159 / 1000000000 : ℚ)  -- the estimate's band, below: ℓlo ≤ λ V / D
  ℓhi := (18668233 / 500000000 : ℚ)   -- and above: λ V / D ≤ ℓhi
  μ := (13 / 100 : ℚ)                 -- the canonical chain's loss of honestly won slots (`ChainQuality`)
  β := (1 / 5 : ℚ)                    -- the adversary's share of the participating stake
  δ := (17 / 200 : ℚ)                 -- the estimate's relative band per epoch
  η := 1 / 10 ^ 70                    -- the lottery threshold's approximation error
  ζ := 1 / 10 ^ 16                    -- the largest note's share of the stake

theorem mainOK : F.mainChk F.S.weakest par.κ par.lp par.lpi dat = true := by decide +kernel

theorem finOK : FamCfg.finChkSpec F F.S.weakest dat Tq par = true := by decide +kernel

/-- **Finality, certified.** f = 1/30, k = 2160, Δ = 11 slots, executions up to slot 31536000. Under the
execution model (`Model`), if the genesis estimate is the genesis stake, the adversary holds at most
0.2 of the participating stake, the canonical chain counts at least 0.87 of
each window's honestly won slots, stake drifts by at most a factor 1.01 per epoch and
honest online stake is at least 1000000, a finality violation has probability at most
8.80e-11. -/
theorem finality {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) (hc : E.c = Config.spec) (hΔ : E.Δ = 11)
    (es : Ω → List Event) (hM : Model μ O E es) (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ 31536000)
    (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (13 / 100 : ℝ) 49)
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) 49)
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (11 / 125000000000 : ℝ) := by
  have h := FamCfg.finality_spec F par mainOK famOK dOK rfl idxOK rfl Tq finOK hc hΔ es hM hN hG
    (fun ω => by simpa [Tq] using hS ω) (fun ω => by simpa [Tq, par] using hQ ω)
    (fun ω => by simpa [par] using hD ω) (fun ω => by simpa [par] using hH ω)
  simpa [par] using h

end Cryptarchia.Prob.Certs.E20D11
