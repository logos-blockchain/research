/-- **Finality, certified.** f = 1/30, k = 2160, Δ = 11 slots, executions up to slot
31536000 (49 epochs). Under the execution model (`Model`), if the genesis estimate is
the genesis stake, the adversary holds at most 0.2 of the participating stake, the
canonical chain counts at least 0.87 of each window's honestly won slots,
stake drifts by at most a factor 1.01 per epoch and honest online stake is at
least 1000000, a finality violation has probability at most 8.80e-11. -/
theorem finality {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) (hc : E.c = Config.spec) (hΔ : E.Δ = 11)
    (es : Ω → List Event) (hM : Model μ O E es) (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ 31536000)
    (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (13 / 100 : ℝ) 49)
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) 49)
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (11 / 125000000000 : ℝ) := by
  have hEL : E.c.epochLength = 648000 := by rw [hc]; rfl
  have hP : E.c.period = 388800 := by rw [hc]; rfl
  have hb := Prob.finality (M := 31538996) (Ne := 49) es hM hN hΔ (D3 E.c.epochLength hEL)
    (fun k => by fin_cases k; exacts [prod0, prod1, prod2, prod3, prod4, prod5, prod6, prod7, prod8, prod9, prod10, prod11, prod12, prod13, prod14, prod15, prod16, prod17, prod18, prod19, prod20, prod21, prod22, prod23, prod24, prod25, prod26, prod27, prod28, prod29, prod30, prod31])
    (G' := 2246) (J := 18473) (Lw := 33871) (r := 462) (T := 22) (x := (3091 / 2500 : ℝ)) (yy := (947 / 1250 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by norm_num [B])
    (by rw [hEL]; norm_num) (by rw [hEL, hc]; norm_num [Config.spec, Config.nonceOffset, Config.s, Config.kf])
    (by rw [hc]; exact lot) TbOK (by rw [hc]; rfl) (by rw [hc]; norm_num [Config.spec])
    (by rw [hc]; norm_num [Config.spec, Config.period, Config.kf])
    (by rw [hP]; norm_num) (by rw [hP, hEL]; norm_num) (by rw [hEL]; norm_num)
    (mem := mem) (fun k => by fin_cases k <;> rfl)
    (fun k => by fin_cases k; exacts [ok0, ok1, ok2, ok3, ok4, ok5, ok6, ok7, ok8, ok9, ok10, ok11, ok12, ok13, ok14, ok15, ok16, ok17, ok18, ok19, ok20, ok21, ok22, ok23, ok24, ok25, ok26, ok27, ok28, ok29, ok30, ok31]) covM advM
    (ρ := (101 / 100 : ℝ)) (Hmin := (1000000 : ℝ)) (by norm_num) (by norm_num)
    (by rw [hc]; unfold lam0 Kc; norm_num [Tb, TBand.clo, TBand.Yh, TBand.ylo, errHi, Config.spec, Config.period,
      Config.kf, Config.t0Const, Config.p])
    (by rw [hc]; unfold lam0 Kc; norm_num [Tb, TBand.chi, TBand.Yh, TBand.Ya, errLo, Config.spec, Config.period,
      Config.kf, Config.t0Const, Config.p])
    (by rw [hc]; unfold lam0; norm_num [Tb, Config.spec, Config.t0Const, Config.p])
    (by rw [hc]; unfold lam0; norm_num [Tb, Config.spec, Config.t0Const, Config.p])
    hG hS hQ hD hH
  rw [hP] at hb
  have h1 := ENNReal.ofReal_le_ofReal (eps_le E hc)
  have h2 := ENNReal.ofReal_le_ofReal band_le
  refine hb.trans ((add_le_add h1 (mul_le_mul_right h2 _)).trans ?_)
  rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_add (by positivity) (by positivity)]
  exact ENNReal.ofReal_le_ofReal (by norm_num)


