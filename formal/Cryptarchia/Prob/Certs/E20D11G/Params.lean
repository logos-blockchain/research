module

public import Cryptarchia.Prob.CertSpec
meta import Cryptarchia.Prob.CertSpec

/-!
# E20D11G: the chosen numbers

Generated by `tools/certgen/emitF.py`. Every number of the certificate that a search chose, and the
rules for the estimate's band and the band family's breakpoints; Lean computes the rest (`Data.lean`,
the main file) and the kernel checks it.
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11G

open Cryptarchia Cryptarchia.Prob

/-- The potential's parameters. -/
def pot : PotCfg where
  Δ := 11             -- the network delay, in slots
  c := (27 / 20 : ℚ)  -- the potential's base for the reach
  z := (2 : ℚ)        -- the potential's base for the margin, when cold
  s := (1 : ℚ)        -- the weight of the cold potential's first term
  d := (1 : ℚ)        -- the base of the cold potential's second term
  τ := (41 / 40 : ℚ)  -- the span term's base per slot

/-- The certificate's other chosen numbers. -/
def par : SpecData where
  k := 1000              -- the security parameter: the configuration is `Config.specK k`
  κ := (0 : ℚ)           -- the weight of the cold potential's second term: off, the tables bound failed checks
  N := 5184000           -- the horizon: executions up to slot N
  ε := (1 / 100 : ℚ)     -- each lesser term (long phases, long empty runs, large reach) at most this share of the main ones
  ρ := (101 / 100 : ℚ)   -- the stake drift per epoch (`StakeDrift`)
  Hmin := (1000000 : ℚ)  -- the least honest online stake (`MinStake`)

/-- The estimate's band `λV/D ∈ [ℓlo, ℓhi]`: the least that the stake drift allows
(`TBandQ.ofDrift`). -/
def Tq : TBandQ :=
  eval% TBandQ.ofDrift (Config.specK par.k)
    (13 / 100 : ℚ)  -- μ: the canonical chain's loss of honestly won slots (`ChainQuality`)
    (1 / 5 : ℚ)     -- β: the adversary's share of the participating stake
    (17 / 200 : ℚ)  -- δ: the estimate's relative band per epoch
    (1 / 10 ^ 70)   -- η: the lottery threshold's approximation error
    (1 / 10 ^ 16)   -- ζ: the largest note's share of the stake
    par.ρ par.Hmin  -- the stake drift and the least honest stake
    8 30            -- 8 digits, 30 rounds

/-- The band family: 32 members over the estimate's band. -/
def S : FamSpec where
  η := Tq.η                              -- the lottery threshold's approximation error
  ζ := Tq.ζ                              -- the largest note's share of the stake
  β := Tq.β                              -- the adversary's share of the participating stake
  d := 13                                -- significant digits of the bands' fields
  dy := 12                               -- significant digits of the adversarial exponent's bound
  K := 32                                -- the members
  ys := eval% geomYs Tq.ylo Tq.Yh 32 12  -- the breakpoints: [ylo, Yh] split geometrically

end Cryptarchia.Prob.Certs.E20D11G
