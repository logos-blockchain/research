/-!
# Finality certificate with grouped table potentials: β = 1/5, Δ = 11, k = 1000

Generated by `tools/certgen/emitTG.py`. The specification's parameters with security parameter
k = 1000 (f = 1/30) are `Config.specK 1000`'s. The failed checks are bounded by a table potential per
group of 4 groups of band members, grown by `γ` per slot of the epoch's age (`Prob/TableG.lean`).
The certificate is the data below; Lean computes the rest and the kernel checks it (`TableGCert.lean`,
`TableGSpec.lean`):

- the chosen numbers (`Params.lean`) and the family's integer bands (`Data.lean`), with the potential's
  second term off (`κ = 0`);
- the switching tables of the reach, the checked phase and spans (`Sw.lean`);
- the tables (`Tab.lean`), and each (group, representative)'s terminal table and one-switch tables
  (`R<j>.lean`);
- the derived numbers `der`: the tables' contractions, the settlement parameters and the bounds, computed by
  the generator's mirror of the rules (`tools/certgen/tabsim.py`, `SpecData.deriveLE`); the kernel checks every
  condition on them, so they need not follow the rules;
- the checks of the reach potential (`c2OK`), the tables (`tabOK`) and every numeric condition (`finOK`).
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11G

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The phase indices' data: the switching tables of indices 0, 1, 2, 17; the others take no part. -/
def datZ : IdxData := ⟨[], [], [], 0, [], 0⟩

def dat : Fin 19 → IdxData := ![dat0, dat1, dat2, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, datZ, dat17, datZ]

theorem swOK : ∀ i : Fin 19, FamCfg.isSw i = true → F.idxChkSw i (dat i) = true := by
  intro i; fin_cases i
  exacts [fun _ => sw0, fun _ => sw1, fun _ => sw2, fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun h => absurd h (by decide), fun _ => sw17, fun h => absurd h (by decide)]

/-- The (group, representative) entries, in chunks, by list lookup (Lean's interpreter takes time exponential in the
index to evaluate `![…]`). -/
def D (j : Fin 56) : List (ℕ × (ℤ × ℤ) × RepData) := [D0, D1, D2, D3, D4, D5, D6, D7, D8, D9, D10, D11, D12, D13, D14, D15, D16, D17, D18, D19, D20, D21, D22, D23, D24, D25, D26, D27, D28, D29, D30, D31, D32, D33, D34, D35, D36, D37, D38, D39, D40, D41, D42, D43, D44, D45, D46, D47, D48, D49, D50, D51, D52, D53, D54, D55].getD j.val []

theorem tabA : F.tabChkAG Q γ nG Rd cst D := by
  intro j; fin_cases j
  exacts [chkA0, chkA1, chkA2, chkA3, chkA4, chkA5, chkA6, chkA7, chkA8, chkA9, chkA10, chkA11, chkA12, chkA13, chkA14, chkA15, chkA16, chkA17, chkA18, chkA19, chkA20, chkA21, chkA22, chkA23, chkA24, chkA25, chkA26, chkA27, chkA28, chkA29, chkA30, chkA31, chkA32, chkA33, chkA34, chkA35, chkA36, chkA37, chkA38, chkA39, chkA40, chkA41, chkA42, chkA43, chkA44, chkA45, chkA46, chkA47, chkA48, chkA49, chkA50, chkA51, chkA52, chkA53, chkA54, chkA55]

/-- The derived numbers: the settlement parameters `Lw J x G G' r T yy`, the slots and epochs covered
`M Ne`, the contractions `lp lpi`, and the bounds `tgt bx fin`. -/
def der : SpecDerived :=
  ⟨15055, 7940, (12923 / 10000 : ℚ), 363, 1282, 106, 34, (703 / 1250 : ℚ), 5185658, 18,
    (250960461 / 250000000 : ℚ), (2492155357 / 2500000000 : ℚ), (31 / 1000000 : ℚ), (6603 / 10000000000 : ℚ), (43 / 1000000 : ℚ)⟩

theorem derNe : der.Ne = 18 := rfl

theorem derFin : der.fin = (43 / 1000000 : ℚ) := rfl

theorem c2OK : cert2ChkQ F.S.weakest F.Δ F.c F.z F.s 0 F.d F.τ 0 (FamCfg.lrOf dat) (FamCfg.bOf dat) (FamCfg.eOf dat) =
    true := by
  decide +kernel

theorem tabOK : F.tabChkG Q nG γ Γ (Config.specK par.k).epochLength der.G Rd cst der.lp der.lpi D = true := by
  decide +kernel

theorem stOK : startChk ((Config.specK par.k).epochLength - 1) 10 γ sU = true := by decide +kernel

theorem finOK : FamCfg.finChkSpecE F F.S.weakest dat (FamCfg.eOf dat 2 * sU) (fun _ => Rd) Tq par der = true := by
  decide +kernel

/-- **Finality, certified** (`Claim.Finality`): f = 1/30, k = 1000, Δ = 11 slots, executions up to
slot 5184000; the adversary holds at most 0.2 of the participating stake, stakes are at most
10³⁰, the canonical chain counts at least 0.87 of each window's honestly won slots,
stake drifts by at most a factor 1.01 per epoch and honest online stake is at least
1000000; a finality violation has probability at most 4.30e-05. -/
theorem finality :
    Claim.Finality (k := 1000) (Δ := 11) (N := 5184000) (β := (1 / 5 : ℝ)) (Smax := 10 ^ 30) (μ := (13 / 100 : ℝ))
      (ρ := (101 / 100 : ℝ)) (Hmin := (1000000 : ℝ)) (ε := (43 / 1000000 : ℝ)) := by
  intro Ω _ μ _ O E es hM hc hΔ hN hG hS hQ hD hH
  have hT : Tq.β = (1 / 5 : ℚ) ∧ Tq.ζ = 1 / 10 ^ 16 ∧ Tq.μ = (13 / 100 : ℚ) := by decide +kernel
  have h := FamCfg.finality_specTG F par der c2OK famOK dOK rfl swOK tabOK tabA rfl stOK Tq finOK (by rw [hc]; rfl)
    hΔ es hM hN (Smax := 10 ^ 30) (by rw [hT.2.1]; decide +kernel) (by rw [derNe]; decide +kernel) hG
    (fun ω => by rw [hT.1]; simpa using hS ω) (fun ω => by rw [hT.2.2]; simpa [par] using hQ ω)
    (fun ω => by simpa [par] using hD ω) (fun ω => by simpa [par] using hH ω)
  rw [derFin] at h
  simpa using h

end Cryptarchia.Prob.Certs.E20D11G
