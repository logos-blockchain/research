theorem chkS1 : ∀ k, (autoSolZ (famZ k) DZ 11 X1 SZ vs1Z &&
    decide ((autoBoundZ (famZ k) DZ X1 SZ vs1Z : ℚ) ≤ eS1 k * (X1.M DZ * SZ : ℤ))) = true := by
  decide +kernel

noncomputable def vs1 : ℕ → Fin 3 → Bool → ℝ := castT (castZ SZ vs1Z)

