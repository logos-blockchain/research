def pre11Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X11 SZ vmax11Z (preTop11 k)

/-- Every check of member `k`, as one Boolean. -/
def chkE11Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X11 SZ (post11Z k) && leTabZ 11 (post11Z k) vmax11Z &&
    preSolZ (famZ k) DZ 11 X11 SZ vmax11Z (pre11Z k) &&
    decide ((autoBoundZ (famZ k) DZ X11 SZ (post11Z k) : ℚ) ≤ eIn11 k * (X11.M DZ * SZ : ℤ)) &&
    decide ((autoBoundZ (famZ k) DZ X11 SZ (pre11Z k) : ℚ) ≤ (4938990071369 / 5000000000000 : ℚ) * (X11.M DZ * SZ : ℤ))

