def post4Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X4 SZ (gFloorZ X4 SZ) (postTop4 k)
def pre4Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X4 SZ vmax4Z (preTop4 k)

/-- Every check of member `k`, as one Boolean. -/
def chkE4Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X4 SZ (post4Z k) && leTabZ 11 (post4Z k) vmax4Z &&
    preSolZ (famZ k) DZ 11 X4 SZ vmax4Z (pre4Z k) &&
    decide ((autoBoundZ (famZ k) DZ X4 SZ (post4Z k) : ℚ) ≤ eIn4 k * (X4.M DZ * SZ : ℤ)) &&
    decide ((autoBoundZ (famZ k) DZ X4 SZ (pre4Z k) : ℚ) ≤ (9975933117267 / 10000000000000 : ℚ) * (X4.M DZ * SZ : ℤ))

