def post12Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X12 SZ (gFloorZ X12 SZ) (postTop12 k)
def pre12Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X12 SZ vmax12Z (preTop12 k)

/-- Every check of member `k`, as one Boolean. -/
def chkE12Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X12 SZ (post12Z k) && leTabZ 11 (post12Z k) vmax12Z &&
    preSolZ (famZ k) DZ 11 X12 SZ vmax12Z (pre12Z k) &&
    decide ((autoBoundZ (famZ k) DZ X12 SZ (post12Z k) : ℚ) ≤ eIn12 k * (X12.M DZ * SZ : ℤ)) &&
    decide ((autoBoundZ (famZ k) DZ X12 SZ (pre12Z k) : ℚ) ≤ (1003907727463 / 1000000000000 : ℚ) * (X12.M DZ * SZ : ℤ))

