theorem chkS0 : ∀ k, (autoSolZ (famZ k) DZ 11 X0 SZ vs0Z &&
    decide ((autoBoundZ (famZ k) DZ X0 SZ vs0Z : ℚ) ≤ eS0 k * (X0.M DZ * SZ : ℤ))) = true := by
  decide +kernel

noncomputable def vs0 : ℕ → Fin 3 → Bool → ℝ := castT (castZ SZ vs0Z)

