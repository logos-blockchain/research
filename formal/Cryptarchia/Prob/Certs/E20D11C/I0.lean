theorem xgQ0 : xg (11833 / 10000 : ℝ) (17137 / 10000 : ℝ) (11 / 10 : ℝ) (1809 / 5000 : ℝ) (51 / 50 : ℝ) 0 = castX (xgNQ (11833 / 10000 : ℚ) (17137 / 10000 : ℚ) (11 / 10 : ℚ) (1809 / 5000 : ℚ) (51 / 50 : ℚ) 0) :=
  xg_ofQ (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) 0

/-- Phase expectation 0 over the integers. -/
def X0 : PhZ := ⟨11833, 10000, 1, 1,
  fun a b u => [11833, 11833, 10000, 10000, 11833, 11833, 10000, 10000, 11833, 11833, 10000, 10000].getD (4 * a.val + (if b then 2 else 0) + if u then 1 else 0) 0,
  11833⟩

theorem X0R : X0.Rep (xgNQ (11833 / 10000 : ℚ) (17137 / 10000 : ℚ) (11 / 10 : ℚ) (1809 / 5000 : ℚ) (51 / 50 : ℚ) 0).1 (xgNQ (11833 / 10000 : ℚ) (17137 / 10000 : ℚ) (11 / 10 : ℚ) (1809 / 5000 : ℚ) (51 / 50 : ℚ) 0).2.1 (xgNQ (11833 / 10000 : ℚ) (17137 / 10000 : ℚ) (11 / 10 : ℚ) (1809 / 5000 : ℚ) (51 / 50 : ℚ) 0).2.2 := by decide +kernel

/-- The switching table, from its entries at `(0, a, true)`. -/
def vs0Z : ℕ → Fin 3 → Bool → ℤ :=
  fillAllZ ((List.finRange 32).map famZ) DZ 11 X0 SZ (fun _ _ _ => 0) ![16014512958895716869, 16014512958895716869, 16014512958895716869]

