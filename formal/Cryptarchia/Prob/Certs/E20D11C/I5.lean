def post5Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X5 SZ (gFloorZ X5 SZ) (postTop5 k)
def pre5Z (k : Fin 32) : ℕ → Fin 3 → Bool → ℤ := fillZ (famZ k) DZ 11 X5 SZ vmax5Z (preTop5 k)

/-- Every check of member `k`, as one Boolean. -/
def chkE5Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X5 SZ (post5Z k) && leTabZ 11 (post5Z k) vmax5Z &&
    preSolZ (famZ k) DZ 11 X5 SZ vmax5Z (pre5Z k) &&
    decide ((autoBoundZ (famZ k) DZ X5 SZ (post5Z k) : ℚ) ≤ eIn5 k * (X5.M DZ * SZ : ℤ)) &&
    decide ((autoBoundZ (famZ k) DZ X5 SZ (pre5Z k) : ℚ) ≤ (1997963426399 / 2000000000000 : ℚ) * (X5.M DZ * SZ : ℤ))

