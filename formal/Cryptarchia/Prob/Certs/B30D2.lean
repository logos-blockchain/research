  simp only [P, List.mem_singleton] at hB'; subst hB'; exact hBp

/-- **Certified finality from a random oracle.** f = 1/30, k = 2160, β = 0.3, Δ = 2 slots, one epoch. The tickets are a random
oracle, each slot's tickets are fresh given the past and the slot's epoch state (no
grinding), honest blocks are delivered within Δ, and every epoch state a slot's
lottery runs under is within the band `B`. Then a finality violation has probability
at most `1/1000000000000000000000000000`. -/
theorem certified {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) (hc : E.c = Config.spec) (hΔ : E.Δ = 2)
    (hA : Assm E) (es : Ω → List Event) (hNF : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ 648000)
    (hdel : ∀ ω, DeltaDelivery (E.withO (O ω)) (es ω)) (hO : RandomOracle μ O E.c.p)
    (hσm : ∀ i, Measurable fun ω => σE (E.withO (O ω)) (es ω) i)
    (hfresh : Fresh μ O fun ω => σE (E.withO (O ω)) (es ω))
    (hband : ∀ ω i, 1 ≤ i → i ≤ 651560 → SlotBand B E i (σE (E.withO (O ω)) (es ω) i)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (1 / 1000000000000000000000000000 : ℝ) :=
  (final_bimm_ro (M := 651560) hA es hNF hdel hO hσm hfresh hΔ P hBs
    (fun ω i h1 h2 => ⟨B, List.mem_singleton_self B, hband ω i h1 h2⟩) (G := 58) (G' := 3556) (J := 45860) (Lw := 49000)
    (r := 528) (T := 17) (x := (1337 / 1000 : ℝ)) (yy := (49 / 100 : ℝ)) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by norm_num [B])).trans
    (ENNReal.ofReal_le_ofReal (eps_le E hc))

