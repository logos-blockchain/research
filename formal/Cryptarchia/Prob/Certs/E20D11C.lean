/-!
# Closed-form finality certificate: β = 1/5, Δ = 11, every k ≥ 1000, 32 members

Generated by `tools/certgen/emitF.py`. The certificate is the data below; Lean computes the rest
and the kernel checks it (`CertGen.lean`, `CertClosed.lean`). The settlement parameters grow
linearly in `t = k / 20`, and `finality_closed` bounds a finality violation by `par.epsC N k`, a
sum of geometric terms in `t`, for every depth `k ≥ 1000` and every horizon `N`.
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11C

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The phase indices' data. -/
def dat : Fin 19 → IdxData := ![dat0, dat1, dat2, dat3, dat4, dat5, dat6, dat7, dat8, dat9, dat10, dat11, dat12, dat13, dat14, dat15, dat16, dat17, dat18]

theorem idxOK : ∀ i : Fin 19, F.idxChk i (dat i) = true := by
  intro i; fin_cases i
  exacts [chk0, chk1, chk2, chk3, chk4, chk5, chk6, chk7, chk8, chk9, chk10, chk11, chk12, chk13, chk14, chk15, chk16, chk17, chk18]

