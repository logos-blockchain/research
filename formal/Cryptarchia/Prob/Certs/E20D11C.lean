/-!
# Closed-form finality certificate: β = 1/5, Δ = 11, every k ≥ 1000, 32 members

Generated by `tools/certgen/emitF.py`. The certificate is the data below; Lean computes the rest
and the kernel checks it (`CertGen.lean`, `CertClosed.lean`). The settlement parameters grow
linearly in `t = k / 20`, and `finality_closed` bounds a finality violation by `par.epsC N k`, a
sum of geometric terms in `t`, for every depth `k ≥ 1000` and every horizon `N`.
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11C

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The phase indices' data. -/
def dat : Fin 19 → IdxData := ![dat0, dat1, dat2, dat3, dat4, dat5, dat6, dat7, dat8, dat9, dat10, dat11, dat12, dat13, dat14, dat15, dat16, dat17, dat18]

theorem idxOK : ∀ i : Fin 19, F.idxChk i (dat i) = true := by
  intro i; fin_cases i
  exacts [chk0, chk1, chk2, chk3, chk4, chk5, chk6, chk7, chk8, chk9, chk10, chk11, chk12, chk13, chk14, chk15, chk16, chk17, chk18]

/-- The certificate's chosen numbers. -/
def par : ClosedData where
  κ := (547 / 5000 : ℚ)                                                    -- the weight of the cold potential's second term
  lp := (9991766645103 / 10000000000000 : ℚ)                               -- the potential's contraction per phase
  lpi := (9979331723103 / 10000000000000 : ℚ)                              -- its contraction per phase inside an epoch
  G := 704                                                                 -- the phase cut: longer phases count as failures
  g := 19                                                                  -- the longest empty run, per t = k / 20
  j := 172                                                                 -- the phases of a span, per t
  w := 315                                                                 -- the slots of a span, and of a crowded window, per t
  ρr := 3                                                                  -- the reach bound, per t
  T := 14                                                                  -- the growth block, in slots
  m := 20                                                                  -- the depth per t
  nb := 96                                                                 -- the growth blocks per t
  nb0 := 30                                                                -- less these
  k0 := 1000                                                               -- the least depth
  x := (12307 / 10000 : ℚ)                                                 -- the crowded-window tilt
  yy := (997 / 1250 : ℚ)                                                   -- the slow-growth tilt
  ρ := (101 / 100 : ℚ)                                                     -- the stake drift per epoch (`StakeDrift`)
  Hmin := (1000000 : ℚ)                                                    -- the least honest online stake (`MinStake`)
  A1 := (68540061675157 / 100000000000000000000000000000000000000000 : ℚ)  -- long phases: (N + g t + 1) · A1
  q2 := (63295647758391 / 100000000000000 : ℚ)                             -- long empty runs: (N + 1) · q2ᵗ
  A3 := (10142598762951 / 10000000000000 : ℚ)                              -- long spans: A3 · q3ᵗ per horizon slot
  q3 := (3363687461371 / 5000000000000 : ℚ)                                -- long spans: the rate per t
  A4 := (7730462945107 / 20000000000000 : ℚ)                               -- failed checks: A4 · q4ᵗ per horizon slot
  q4 := (35028456115191 / 50000000000000 : ℚ)                              -- failed checks: the rate per t
  A5 := (16250914113919 / 20000000000000 : ℚ)                              -- crowded windows: A5 · q5ᵗ per horizon slot
  q5 := (17124504232097 / 25000000000000 : ℚ)                              -- crowded windows: the rate per t
  A6 := (21840405971703 / 10000000000000 : ℚ)                              -- large reach: A6 · q6ᵗ per horizon slot
  q6 := (63751989880813 / 100000000000000 : ℚ)                             -- large reach: the rate per t
  A7 := (441101827619 / 800000000 : ℚ)                                     -- slow growth: A7 · q7ᵗ per horizon slot
  q7 := (14790947058993 / 25000000000000 : ℚ)                              -- slow growth: the rate per t
  C1 := (10000849 / 10000000 : ℚ)                                          -- the band, below: C1 · (1 / Q1)ᵗ per epoch
  Q1 := (6787204045793 / 5000000000000 : ℚ)                                -- its rate
  C2 := (1000081693 / 1000000000 : ℚ)                                      -- the band, above: C2 · (1 / Q2)ᵗ per epoch
  Q2 := (13418599101303 / 10000000000000 : ℚ)                              -- its rate
  t0 := 50                                                                 -- the short form holds from t ≥ t0
  qs := (70057 / 100000 : ℚ)                                               -- its settlement rate, 0.700570
  As := (2319019 / 2500000 : ℚ)                                            -- and constant
  qb := (149047 / 200000 : ℚ)                                              -- its band rate, 0.745235
  Ab := (780757 / 500000 : ℚ)                                              -- and constant

/-- The estimate's band: `λV/D ∈ [ℓlo, ℓhi]`, μ = 13/100, β = 1/5, δ = 17/200. -/
def Tq : TBandQ where
  ℓlo := (30108409 / 1000000000 : ℚ)  -- the estimate's band, below: ℓlo ≤ λ V / D
  ℓhi := (2333537 / 62500000 : ℚ)     -- and above: λ V / D ≤ ℓhi
  μ := (13 / 100 : ℚ)                 -- the canonical chain's loss of honestly won slots (`ChainQuality`)
  β := (1 / 5 : ℚ)                    -- the adversary's share of the participating stake
  δ := (17 / 200 : ℚ)                 -- the estimate's relative band per epoch
  η := 1 / 10 ^ 70                    -- the lottery threshold's approximation error
  ζ := 1 / 10 ^ 16                    -- the largest note's share of the stake

theorem mainOK : F.mainChk F.S.weakest par.κ par.lp par.lpi dat = true := by decide +kernel

theorem closedOK : FamCfg.closedChk F F.S.weakest dat Tq par = true := by decide +kernel

/-- **Finality in closed form.** f = 1/30, Δ = 11 slots, any depth `k ≥ 1000` and any horizon `N`.
Under the execution model (`Model`), if the genesis estimate is the genesis stake, the adversary
holds at most 0.2 of the participating stake, the canonical chain counts at least
0.87 of each window's honestly won slots, stake drifts by at most a factor
1.01 per epoch and honest online stake is at least 1000000, a finality violation has
probability at most `par.epsC N k`. -/
theorem finality_closed {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) {k : ℕ} (hc : E.c = Config.specK k) (hk : 1000 ≤ k) (hΔ : E.Δ = 11) (es : Ω → List Event)
    (hM : Model μ O E es) {N : ℕ} (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ N) (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (13 / 100 : ℝ) (N / (300 * k) + 2))
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) (N / (300 * k) + 2))
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (par.epsC N k) :=
  FamCfg.finality_closed_gen F par mainOK famOK dOK rfl idxOK rfl Tq closedOK
    (fun k hk => by simp only [par, F] at hk ⊢; omega) (fun k hk => by simp only [par] at hk ⊢; omega)
    (fun k hk => by simp only [par, F] at hk ⊢; omega) E hc hk hΔ es hM hN hG
    (fun ω => by simpa [Tq] using hS ω) (fun ω => by simpa [Tq] using hQ ω) (fun ω => by simpa [par] using hD ω)
    (fun ω => by simpa [par] using hH ω)

/-- **Finality in closed form, short**: with `t = k / 20` and `Ne = N / (300 k) + 2` epochs, a
finality violation has probability at most
`(N + 19 t + 706) · (6.9e-28 + 0.9276 · 0.700570ᵗ) + Ne · 1.562 · 0.745235ᵗ`:
settlement at rate 0.7006 per 20 blocks of depth, the estimate's band at rate 0.7452. -/
theorem finality_closed_short {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) {k : ℕ} (hc : E.c = Config.specK k) (hk : 1000 ≤ k) (hΔ : E.Δ = 11) (es : Ω → List Event)
    (hM : Model μ O E es) {N : ℕ} (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ N) (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (13 / 100 : ℝ) (N / (300 * k) + 2))
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) (N / (300 * k) + 2))
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (par.epsShort N k) :=
  (finality_closed E hc hk hΔ es hM hN hG hS hQ hD hH).trans
    (ENNReal.ofReal_le_ofReal (FamCfg.epsC_le_short par closedOK N hk))

end Cryptarchia.Prob.Certs.E20D11C
