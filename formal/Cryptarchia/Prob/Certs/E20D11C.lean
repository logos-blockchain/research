/-- **The bound in closed form**: `epsS` plus the estimate's band in each of the
`N / (300 k) + 2` epochs. -/
noncomputable def epsC (N k : ℕ) : ℝ :=
  epsS N (k / 20) + ((N / (300 * k) + 2 : ℕ) : ℝ) * ((100008499 / 100000000 : ℝ) * (1 / (271575547839 / 200000000000 : ℝ)) ^ (k / 20) + (1000081779 / 1000000000 : ℝ) * (1 / (13422755053069 / 10000000000000 : ℝ)) ^ (k / 20))

/-- **Finality in closed form.** f = 1/30, Δ = 11 slots, any depth `k ≥ 1000` and any horizon
`N`. Under the execution model (`Model`), if the genesis estimate is the genesis stake, the
adversary holds at most 0.2 of the participating stake, the canonical chain counts at least
0.9 of each window's honestly won slots, stake drifts by at most a factor 1.01 per
epoch and honest online stake is at least 1000000, a finality violation has probability at most
`epsC N k`. Every term of `epsC` decays geometrically in `k / 20`. -/
theorem finality_closed {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) {k : ℕ} (hc : E.c = Config.specK k)
    (hk : 1000 ≤ k) (hΔ : E.Δ = 11) (es : Ω → List Event) (hM : Model μ O E es) {N : ℕ}
    (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ N)
    (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (1 / 10 : ℝ) (N / (300 * k) + 2))
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) (N / (300 * k) + 2))
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (epsC N k) := by
  have hEL : E.c.epochLength = 300 * k := by rw [hc, Config.specK_epochLength]
  have hP : E.c.period = 180 * k := by rw [hc, Config.specK_period]
  have hb := Prob.finality (M := N + 759 + 19 * (k / 20) + 11 + 2) (Ne := N / (300 * k) + 2) es hM hN hΔ
    (D3 E.c.epochLength (by rw [hEL]; omega))
    (fun kk => by fin_cases kk; exacts [prod0, prod1, prod2, prod3, prod4, prod5, prod6, prod7, prod8, prod9, prod10, prod11, prod12, prod13, prod14, prod15, prod16, prod17, prod18, prod19, prod20, prod21, prod22, prod23, prod24, prod25, prod26, prod27, prod28, prod29, prod30, prod31])
    (G' := 19 * (k / 20)) (J := 178 * (k / 20)) (Lw := 322 * (k / 20)) (r := 4 * (k / 20)) (T := 39) (x := (12461 / 10000 : ℝ)) (yy := (1001 / 2000 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) le_rfl
    (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by norm_num [B])
    (by rw [hEL]; omega) (by rw [hEL, hc, Config.specK_nonceOffset]; omega)
    (by rw [hc]; exact lotConsts_specK lot k) TbOK (by rw [hc]; rfl) (by rw [hc]; norm_num [Config.specK, Config.spec])
    (by rw [hP, hc]; simp only [Config.specK, Config.spec]; omega) (by rw [hP]; omega) (by rw [hP, hEL]; omega)
    (by rw [hEL, show N + 759 + 19 * (k / 20) + 11 + 2 = N + (759 + 19 * (k / 20) + 11 + 2) by ring]
        exact div_lt_add_two (by omega))
    (mem := mem) (fun kk => by fin_cases kk <;> rfl)
    (fun kk => by fin_cases kk; exacts [ok0, ok1, ok2, ok3, ok4, ok5, ok6, ok7, ok8, ok9, ok10, ok11, ok12, ok13, ok14, ok15, ok16, ok17, ok18, ok19, ok20, ok21, ok22, ok23, ok24, ok25, ok26, ok27, ok28, ok29, ok30, ok31]) covM advM
    (ρ := (101 / 100 : ℝ)) (Hmin := (1000000 : ℝ)) (by norm_num) (by norm_num)
    (by
      rw [hc, lam0_specK]
      have e : ∀ K' P' : ℝ, Tb.ℓhi * K' * (1 - Tb.μ) * (1 - Tb.δ) * Tb.clo * (P' - 1) / (101 / 100 : ℝ) =
          (Tb.ℓhi * (1 - Tb.μ) * (1 - Tb.δ) * Tb.clo / (101 / 100 : ℝ)) * K' * (P' - 1) := by intros; ring
      rw [e]
      exact hup_of_k0 hk (by norm_num) (by norm_num [Tb, TBand.Yh, TBand.Ya, TBand.ylo, TBand.clo, TBand.chi, errHi, errLo])
        (by unfold lam0; norm_num [Tb, TBand.Yh, TBand.Ya, TBand.ylo, TBand.clo, TBand.chi, errHi, errLo, Config.spec]))
    (by
      rw [hc, lam0_specK]
      have e : ∀ K' P' : ℝ, Tb.ℓlo * K' * (1 + Tb.δ) * Tb.chi * P' * (101 / 100 : ℝ) =
          (Tb.ℓlo * (1 + Tb.δ) * Tb.chi * (101 / 100 : ℝ)) * K' * P' := by intros; ring
      rw [e]
      exact hdn_of_k0 hk (by norm_num) (by norm_num) (by unfold lam0; norm_num [Tb, TBand.Yh, TBand.Ya, TBand.ylo, TBand.clo, TBand.chi, errHi, errLo, Config.spec]))
    (by rw [hc, lam0_specK]; unfold lam0; norm_num [Tb, Config.spec])
    (by rw [hc, lam0_specK]; unfold lam0; norm_num [Tb, Config.spec])
    hG hS hQ hD hH
  rw [hP] at hb
  have h1 := ENNReal.ofReal_le_ofReal (eps_closed E hc hk N)
  have h2 := ENNReal.ofReal_le_ofReal (band_closed hk)
  refine hb.trans ((add_le_add h1 (mul_le_mul_right h2 _)).trans ?_)
  have hS0 : 0 ≤ epsS N (k / 20) := by unfold epsS; positivity
  rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_add hS0 (by positivity)]
  exact le_rfl

/-- **Finality in closed form, short**: with `t = k / 20` and `Ne = N / (300 k) + 2` epochs, a
finality violation has probability at most
`(N + 19 t + 761) · (7.8e-31 + 2.885 · 0.666201ᵗ) + Ne · 1.561 · 0.745004ᵗ`:
settlement at rate 0.6662 per 20 blocks of depth, the estimate's band at rate 0.7450. -/
theorem finality_closed_short {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) {k : ℕ} (hc : E.c = Config.specK k)
    (hk : 1000 ≤ k) (hΔ : E.Δ = 11) (es : Ω → List Event) (hM : Model μ O E es) {N : ℕ}
    (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ N)
    (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (1 / 10 : ℝ) (N / (300 * k) + 2))
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) (N / (300 * k) + 2))
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤
      ENNReal.ofReal (((N : ℝ) + 19 * ((k / 20) : ℕ) + 761) * ((77694091502453 / 100000000000000000000000000000000000000000000 : ℝ) + (144272726673 / 50000000000 : ℝ) * (666201 / 1000000 : ℝ) ^ (k / 20)) +
        ((N / (300 * k) + 2 : ℕ) : ℝ) * ((1561203 / 1000000 : ℝ) * (186251 / 250000 : ℝ) ^ (k / 20))) := by
  refine (finality_closed E hc hk hΔ es hM hN hG hS hQ hD hH).trans (ENNReal.ofReal_le_ofReal ?_)
  unfold epsC epsS
  have ht0 : 50 ≤ (k / 20) := by omega
  set t := (k / 20) with ht
  simp only [Nat.cast_mul, Nat.cast_ofNat]
  have r2 := geom_le_of (A := (1 : ℝ)) (t0 := 50) (t := t) (by norm_num) (by norm_num : (0 : ℝ) ≤ (12659119233387 / 20000000000000 : ℝ)) (by norm_num : (0 : ℝ) < (666201 / 1000000 : ℝ)) (by norm_num) ht0 (by norm_num : ((1 : ℝ) : ℝ) * ((12659119233387 / 20000000000000 : ℝ) ^ 50 / (666201 / 1000000 : ℝ) ^ 50) ≤ (193353 / 2500000 : ℝ))
  have k2 := mul_le_mul_of_nonneg_left r2 (by positivity : (0 : ℝ) ≤ (N : ℝ) + 1)
  have r3 := geom_le_of (A := (10136119265079 / 10000000000000 : ℝ)) (t0 := 50) (t := t) (by norm_num) (by norm_num : (0 : ℝ) ≤ (32041290557767 / 50000000000000 : ℝ)) (by norm_num : (0 : ℝ) < (666201 / 1000000 : ℝ)) (by norm_num) ht0 (by norm_num : ((10136119265079 / 10000000000000 : ℝ) : ℝ) * ((32041290557767 / 50000000000000 : ℝ) ^ 50 / (666201 / 1000000 : ℝ) ^ 50) ≤ (29083 / 200000 : ℝ))
  have k3 := mul_le_mul_of_nonneg_left r3 (by positivity : (0 : ℝ) ≤ (N : ℝ) + 19 * (t : ℝ) + 1)
  have r4 := geom_le_of (A := (23423715101963 / 50000000000000 : ℝ)) (t0 := 50) (t := t) (by norm_num) (by norm_num : (0 : ℝ) ≤ (66620041154541 / 100000000000000 : ℝ)) (by norm_num : (0 : ℝ) < (666201 / 1000000 : ℝ)) (by norm_num) ht0 (by norm_num : ((23423715101963 / 50000000000000 : ℝ) : ℝ) * ((66620041154541 / 100000000000000 : ℝ) ^ 50 / (666201 / 1000000 : ℝ) ^ 50) ≤ (234227 / 500000 : ℝ))
  have k4 := mul_le_mul_of_nonneg_left r4 (by positivity : (0 : ℝ) ≤ (N : ℝ) + 19 * (t : ℝ) + 1)
  have r5 := geom_le_of (A := (80250381189311 / 100000000000000 : ℝ)) (t0 := 50) (t := t) (by norm_num) (by norm_num : (0 : ℝ) ≤ (10468512131 / 16000000000 : ℝ)) (by norm_num : (0 : ℝ) < (666201 / 1000000 : ℝ)) (by norm_num) ht0 (by norm_num : ((80250381189311 / 100000000000000 : ℝ) : ℝ) * ((10468512131 / 16000000000 : ℝ) ^ 50 / (666201 / 1000000 : ℝ) ^ 50) ≤ (325411 / 1000000 : ℝ))
  have k5 := mul_le_mul_of_nonneg_left r5 (by positivity : (0 : ℝ) ≤ (N : ℝ) + 1)
  have r6 := geom_le_of (A := (20995774350931 / 10000000000000 : ℝ)) (t0 := 50) (t := t) (by norm_num) (by norm_num : (0 : ℝ) ≤ (25502957448059 / 50000000000000 : ℝ)) (by norm_num : (0 : ℝ) < (666201 / 1000000 : ℝ)) (by norm_num) ht0 (by norm_num : ((20995774350931 / 10000000000000 : ℝ) : ℝ) * ((25502957448059 / 50000000000000 : ℝ) ^ 50 / (666201 / 1000000 : ℝ) ^ 50) ≤ (166673 / 50000000000 : ℝ))
  have k6 := mul_le_mul_of_nonneg_left r6 (by positivity : (0 : ℝ) ≤ (N : ℝ) + 759 + 1)
  have r7 := geom_le_of (A := (24437166753123 / 50000 : ℝ)) (t0 := 50) (t := t) (by norm_num) (by norm_num : (0 : ℝ) ≤ (3532198097 / 7812500000 : ℝ)) (by norm_num : (0 : ℝ) < (666201 / 1000000 : ℝ)) (by norm_num) ht0 (by norm_num : ((24437166753123 / 50000 : ℝ) : ℝ) * ((3532198097 / 7812500000 : ℝ) ^ 50 / (666201 / 1000000 : ℝ) ^ 50) ≤ (186883 / 100000 : ℝ))
  have k7 := mul_le_mul_of_nonneg_left r7 (by positivity : (0 : ℝ) ≤ (N : ℝ) + 2)
  have rb0 := geom_le_of (A := (100008499 / 100000000 : ℝ)) (t0 := 50) (t := t) (by norm_num) (by norm_num : (0 : ℝ) ≤ 1 / (271575547839 / 200000000000 : ℝ)) (by norm_num : (0 : ℝ) < (186251 / 250000 : ℝ)) (by norm_num) ht0 (by norm_num : ((100008499 / 100000000 : ℝ) : ℝ) * ((1 / (271575547839 / 200000000000 : ℝ)) ^ 50 / (186251 / 250000 : ℝ) ^ 50) ≤ (561143 / 1000000 : ℝ))
