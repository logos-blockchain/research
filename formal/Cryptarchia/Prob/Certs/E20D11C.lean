/-- **The bound in closed form**: `epsS` plus the estimate's band in each of the
`N / (300 k) + 2` epochs. -/
noncomputable def epsC (N k : ℕ) : ℝ :=
  epsS N (k / 20) + ((N / (300 * k) + 2 : ℕ) : ℝ) * ((10000849 / 10000000 : ℝ) * (1 / (6787204045793 / 5000000000000 : ℝ)) ^ (k / 20) + (1000081693 / 1000000000 : ℝ) * (1 / (13418599101303 / 10000000000000 : ℝ)) ^ (k / 20))

/-- **Finality in closed form.** f = 1/30, Δ = 11 slots, any depth `k ≥ 1000` and any horizon
`N`. Under the execution model (`Model`), if the genesis estimate is the genesis stake, the
adversary holds at most 0.2 of the participating stake, the canonical chain counts at least
0.87 of each window's honestly won slots, stake drifts by at most a factor 1.01 per
epoch and honest online stake is at least 1000000, a finality violation has probability at most
`epsC N k`. Every term of `epsC` decays geometrically in `k / 20`. -/
theorem finality_closed {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) {k : ℕ} (hc : E.c = Config.specK k)
    (hk : 1000 ≤ k) (hΔ : E.Δ = 11) (es : Ω → List Event) (hM : Model μ O E es) {N : ℕ}
    (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ N)
    (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (13 / 100 : ℝ) (N / (300 * k) + 2))
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) (N / (300 * k) + 2))
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (epsC N k) := by
  have hEL : E.c.epochLength = 300 * k := by rw [hc, Config.specK_epochLength]
  have hP : E.c.period = 180 * k := by rw [hc, Config.specK_period]
  have hb := Prob.finality (M := N + 704 + 19 * (k / 20) + 11 + 2) (Ne := N / (300 * k) + 2) es hM hN hΔ
    (D3 E.c.epochLength (by rw [hEL]; omega))
    prod
    (G' := 19 * (k / 20)) (J := 172 * (k / 20)) (Lw := 315 * (k / 20)) (r := 3 * (k / 20)) (T := 14) (x := (12307 / 10000 : ℝ)) (yy := (997 / 1250 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) le_rfl
    (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by norm_num [B])
    (by rw [hEL]; omega) (by rw [hEL, hc, Config.specK_nonceOffset]; omega)
    (by rw [hc]; exact lotConsts_specK lot k) TbOK (by rw [hc]; rfl) (by rw [hc]; norm_num [Config.specK, Config.spec])
    (by rw [hP, hc]; simp only [Config.specK, Config.spec]; omega) (by rw [hP]; omega) (by rw [hP, hEL]; omega)
    (by rw [hEL, show N + 704 + 19 * (k / 20) + 11 + 2 = N + (704 + 19 * (k / 20) + 11 + 2) by ring]
        exact div_lt_add_two (by omega))
    (mem := mem) (fun kk => by fin_cases kk <;> rfl)
    ok covM advM
    (ρ := (101 / 100 : ℝ)) (Hmin := (1000000 : ℝ)) (by norm_num) (by norm_num)
    (by
      rw [hc, lam0_specK]
      have e : ∀ K' P' : ℝ, Tb.ℓhi * K' * (1 - Tb.μ) * (1 - Tb.δ) * Tb.clo * (P' - 1) / (101 / 100 : ℝ) =
          (Tb.ℓhi * (1 - Tb.μ) * (1 - Tb.δ) * Tb.clo / (101 / 100 : ℝ)) * K' * (P' - 1) := by intros; ring
      rw [e]
      exact hup_of_k0 hk (by norm_num) (by norm_num [Tb, TBand.Yh, TBand.Ya, TBand.ylo, TBand.clo, TBand.chi, errHi, errLo])
        (by unfold lam0; norm_num [Tb, TBand.Yh, TBand.Ya, TBand.ylo, TBand.clo, TBand.chi, errHi, errLo, Config.spec]))
    (by
      rw [hc, lam0_specK]
      have e : ∀ K' P' : ℝ, Tb.ℓlo * K' * (1 + Tb.δ) * Tb.chi * P' * (101 / 100 : ℝ) =
          (Tb.ℓlo * (1 + Tb.δ) * Tb.chi * (101 / 100 : ℝ)) * K' * P' := by intros; ring
      rw [e]
      exact hdn_of_k0 hk (by norm_num) (by norm_num) (by unfold lam0; norm_num [Tb, TBand.Yh, TBand.Ya, TBand.ylo, TBand.clo, TBand.chi, errHi, errLo, Config.spec]))
    (by rw [hc, lam0_specK]; unfold lam0; norm_num [Tb, Config.spec])
    (by rw [hc, lam0_specK]; unfold lam0; norm_num [Tb, Config.spec])
    hG hS hQ hD hH
  rw [hP] at hb
  have h1 := ENNReal.ofReal_le_ofReal (eps_closed E hc hk N)
  have h2 := ENNReal.ofReal_le_ofReal (band_closed hk)
  refine hb.trans ((add_le_add h1 (mul_le_mul_right h2 _)).trans ?_)
  have hS0 : 0 ≤ epsS N (k / 20) := by unfold epsS; positivity
  rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_add hS0 (by positivity)]
  exact le_rfl

/-- **Finality in closed form, short**: with `t = k / 20` and `Ne = N / (300 k) + 2` epochs, a
finality violation has probability at most
`(N + 19 t + 706) · (6.9e-28 + 0.9276 · 0.700570ᵗ) + Ne · 1.562 · 0.745235ᵗ`:
settlement at rate 0.7006 per 20 blocks of depth, the estimate's band at rate 0.7452. -/
theorem finality_closed_short {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) {k : ℕ} (hc : E.c = Config.specK k)
    (hk : 1000 ≤ k) (hΔ : E.Δ = 11) (es : Ω → List Event) (hM : Model μ O E es) {N : ℕ}
    (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ N)
    (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (13 / 100 : ℝ) (N / (300 * k) + 2))
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) (N / (300 * k) + 2))
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤
      ENNReal.ofReal (((N : ℝ) + 19 * ((k / 20) : ℕ) + 706) * ((68540061675157 / 100000000000000000000000000000000000000000 : ℝ) + (2319019 / 2500000 : ℝ) * (70057 / 100000 : ℝ) ^ (k / 20)) +
        ((N / (300 * k) + 2 : ℕ) : ℝ) * ((780757 / 500000 : ℝ) * (149047 / 200000 : ℝ) ^ (k / 20))) := by
  refine (finality_closed E hc hk hΔ es hM hN hG hS hQ hD hH).trans (ENNReal.ofReal_le_ofReal ?_)
  unfold epsC epsS
  have ht0 : 50 ≤ (k / 20) := by omega
