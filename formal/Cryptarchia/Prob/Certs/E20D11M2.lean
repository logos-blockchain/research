/-- **Certified multi-epoch finality from a random oracle.** β = 0.2, Δ = 11,
k = 2160, executions up to slot 5184000. Random-oracle tickets, fresh lotteries, Δ-delivery;
`pick` assigns each epoch and state a member. A finality violation has probability at most
`7/20000000000` plus the probability that some slot's state is outside its member's band. -/
theorem certified {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) (hc : E.c = Config.spec) (hΔ : E.Δ = 11)
    (hA : Assm E) (es : Ω → List Event) (hNF : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ 5184000)
    (hdel : ∀ ω, DeltaDelivery (E.withO (O ω)) (es ω)) (hO : RandomOracle μ O E.c.p)
    (hσm : ∀ i, Measurable fun ω => σE (E.withO (O ω)) (es ω) i)
    (hfresh : Fresh μ O fun ω => σE (E.withO (O ω)) (es ω)) (pick : ℕ → EpochState → Fin 6) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (7 / 20000000000 : ℝ) +
      μ {ω | ∃ n < 5186506, ¬ SlotBand (fam (pick ((n + 1) / E.c.epochLength) (σE (E.withO (O ω)) (es ω) (n + 1))))
        E (n + 1)
        (σE (E.withO (O ω)) (es ω) (n + 1))} := by
  have hEL : E.c.epochLength = 648000 := by rw [hc]; rfl
  refine (final_bimm_ro_epoch3_ok (M := 5186506) hA es hNF hdel hO hσm hfresh hΔ (D3 E.c.epochLength hEL)
    (fun k => by fin_cases k; exacts [prod0, prod1, prod2, prod3, prod4, prod5]) pick
    (G' := 1844) (J := 19600) (Lw := 35000) (r := 317) (T := 36) (x := (123 / 100 : ℝ)) (yy := (47 / 100 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by norm_num [B]) (by rw [hEL]; norm_num)).trans
    (add_le_add (ENNReal.ofReal_le_ofReal (eps_le E hc)) le_rfl)


