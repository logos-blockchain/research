/-!
# Multi-epoch finality certificate: β = 1/5, Δ = 11, k = 2160, 32 members

Generated by `tools/certgen/emitF.py`. The specification's parameters (f = 1/30, k = 2160) are
`Config.spec`'s. The certificate is the data below; Lean computes the rest and the kernel checks it
(`CertGen.lean`, `CertSpec.lean`):

- the chosen numbers: the band family, the potential's parameters, the other numbers `par` and the
  estimate's band `Tq` (`Params.lean`);
- each phase index's tables (`Data.lean`);
- the derived numbers `der`, as Lean derives them (`derOK`): the contractions, and the bounds on
  settlement, on leaving the band in one epoch and on a finality violation;
- the checks of the potential (`mainOK`) and of every numeric condition (`finOK`).
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11M2

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The phase indices' data. -/
def dat : Fin 19 → IdxData := ![dat0, dat1, dat2, dat3, dat4, dat5, dat6, dat7, dat8, dat9, dat10, dat11, dat12, dat13, dat14, dat15, dat16, dat17, dat18]

theorem idxOK : ∀ i : Fin 19, F.idxChk i (dat i) = true := by
  intro i; fin_cases i
  exacts [chk0, chk1, chk2, chk3, chk4, chk5, chk6, chk7, chk8, chk9, chk10, chk11, chk12, chk13, chk14, chk15, chk16, chk17, chk18]

/-- The derived numbers. -/
def der : SpecDerived where
  M := 5186921                                -- the slots the analysis covers, N + G + G' + Δ + 2
  Ne := 9                                     -- the epochs they span, M / epoch length + 1
  lp := (9993122321849 / 10000000000000 : ℚ)  -- the potential's contraction per phase, the least meeting the class conditions
  lpi := (99784382037 / 100000000000 : ℚ)     -- its contraction per phase inside an epoch, likewise for each member
  tgt := (3 / 200000000000 : ℚ)               -- the bound on settlement failing, 1.50e-11
  bx := (2343 / 100000000000000000 : ℚ)       -- the bound on leaving the band in one epoch, 2.343e-14
  fin := (1 / 62500000000 : ℚ)                -- the bound on a finality violation, tgt + Ne · bx, 1.60e-11

theorem derOK : F.specDerive F.S.weakest dat Tq par = der := by decide +kernel

theorem mainOK : F.mainChk F.S.weakest par.κ der.lp der.lpi dat = true := by decide +kernel

theorem finOK : FamCfg.finChkSpec F F.S.weakest dat Tq par der = true := by decide +kernel

/-- **Finality, certified.** f = 1/30, k = 2160, Δ = 11 slots, executions up to slot 5184000. Under the
execution model (`Model`), if the genesis estimate is the genesis stake, the adversary holds at most
0.2 of the participating stake, the canonical chain counts at least 0.87 of
each window's honestly won slots, stake drifts by at most a factor 1.01 per epoch and
honest online stake is at least 1000000, a finality violation has probability at most
1.60e-11. -/
theorem finality {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
    [MeasureTheory.IsProbabilityMeasure μ] {O : Ω → Oracle} (E : Env) (hc : E.c = Config.spec) (hΔ : E.Δ = 11)
    (es : Ω → List Event) (hM : Model μ O E es) (hN : ∀ ω, (wF (E.withO (O ω)) (es ω)).now ≤ 5184000)
    (hG : GenesisOK E)
    (hS : ∀ ω, Exec.StakeOK E (O ω) (es ω) (1 / 5 : ℝ) (1 / 10 ^ 16))
    (hQ : ∀ ω, Exec.ChainQuality E (O ω) (es ω) (13 / 100 : ℝ) 9)
    (hD : ∀ ω, Exec.StakeDrift E (O ω) (es ω) (101 / 100 : ℝ) 9)
    (hH : ∀ ω, Exec.MinStake E (O ω) (es ω) (1000000 : ℝ)) :
    μ {ω | Unsafe (E.withO (O ω)) (es ω)} ≤ ENNReal.ofReal (1 / 62500000000 : ℝ) := by
  have h := FamCfg.finality_spec F par der mainOK famOK dOK rfl idxOK rfl Tq finOK hc hΔ es hM hN hG
    (fun ω => by simpa [Tq] using hS ω) (fun ω => by simpa [Tq, der] using hQ ω)
    (fun ω => by simpa [par, der] using hD ω) (fun ω => by simpa [par] using hH ω)
  simpa [der] using h

end Cryptarchia.Prob.Certs.E20D11M2
