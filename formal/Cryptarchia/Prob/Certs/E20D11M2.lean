module

public import Cryptarchia.Prob.Certs.E20D11M2.Data
meta import Cryptarchia.Prob.Certs.E20D11M2.Data

/-!
# Multi-epoch finality certificate: β = 1/5, Δ = 11, k = 2160, 32 members

Generated by `tools/certgen/emitF.py`. The specification's parameters (f = 1/30, k = 2160) are
`Config.spec`'s. The certificate is the data below; Lean computes the rest and the kernel checks it
(`CertGen.lean`, `CertSpec.lean`):

- the chosen numbers: the potential's parameters and the other numbers `par`, with the estimate's
  band and the band family by rule (`Params.lean`);
- each phase index's tables (`Data.lean`);
- the derived numbers `der` (`SpecData.derive`): the contractions, the settlement parameters by rule,
  and the bounds on settlement, on leaving the band in one epoch and on a finality violation;
- the checks of the potential (`mainOK`) and of every numeric condition (`finOK`).
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11M2

open Cryptarchia Cryptarchia.Prob

universe u

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- The phase indices' data. -/
def dat : Fin 19 → IdxData := ![dat0, dat1, dat2, dat3, dat4, dat5, dat6, dat7, dat8, dat9, dat10, dat11, dat12, dat13, dat14, dat15, dat16, dat17, dat18]

theorem idxOK : ∀ i : Fin 19, F.idxChk i (dat i) = true := by
  intro i; fin_cases i
  exacts [chk0, chk1, chk2, chk3, chk4, chk5, chk6, chk7, chk8, chk9, chk10, chk11, chk12, chk13, chk14, chk15, chk16, chk17, chk18]

/-- The derived numbers (`SpecData.derive`), computed at elaboration time: the contractions from the
tables' bounds; the settlement parameters by their rules (Lw = 33795, J = 18401, G = 539, G' = 1910,
r = 297, T = 33) and tilts; the slots and epochs covered; and the bounds on settlement
(1.20e-11), on leaving the band in one epoch (2.343e-14) and on a finality violation
(1.30e-11). The kernel checks every condition on them (`mainOK`, `finOK`). -/
def der : SpecDerived := eval% par.derive F F.S.weakest dat Tq

theorem derNe : der.Ne = 9 := by decide +kernel

theorem derFin : der.fin = (13 / 1000000000000 : ℚ) := by decide +kernel

theorem mainOK : F.mainChk F.S.weakest par.κ der.lp der.lpi dat = true := by decide +kernel

theorem finOK : FamCfg.finChkSpec F F.S.weakest dat Tq par der = true := by decide +kernel

/-- **Finality, certified** (`Claim.Finality`): f = 1/30, k = 2160, Δ = 11 slots, executions up to
slot 5184000; the adversary holds at most 0.2 of the participating stake, stakes are at most
10³⁰, the canonical chain counts at least 0.87 of each window's honestly won slots,
stake drifts by at most a factor 1.01 per epoch and honest online stake is at least
1000000; a finality violation has probability at most 1.30e-11. -/
theorem finality : Claim.Finality.{u} 2160 11 5184000 (1 / 5 : ℝ) (10 ^ 30) (13 / 100 : ℝ) (101 / 100 : ℝ) (1000000 : ℝ)
    (13 / 1000000000000 : ℝ) := by
  intro Ω _ μ _ O E es hM hc hΔ hN hG hS hQ hD hH
  have hT : Tq.β = (1 / 5 : ℚ) ∧ Tq.ζ = 1 / 10 ^ 16 ∧ Tq.μ = (13 / 100 : ℚ) := by decide +kernel
  have h := FamCfg.finality_spec F par der mainOK famOK dOK rfl idxOK rfl Tq finOK (by rw [hc]; rfl) hΔ es hM hN
    (Smax := 10 ^ 30) (by rw [hT.2.1]; decide +kernel) (by rw [derNe]; decide +kernel) hG
    (fun ω => by rw [hT.1]; simpa using hS ω) (fun ω => by rw [hT.2.2]; simpa [par] using hQ ω)
    (fun ω => by simpa [par] using hD ω) (fun ω => by simpa [par] using hH ω)
  rw [derFin] at h
  simpa using h

end Cryptarchia.Prob.Certs.E20D11M2
