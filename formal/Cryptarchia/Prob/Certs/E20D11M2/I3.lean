theorem postS3_0 : AutoSol f0 11 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 3).1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 3).2.1 (xg (1161 / 1000 : ℝ) (2001 / 1250 : ℝ) (5351 / 5000 : ℝ) (6209 / 10000 : ℝ) (51 / 50 : ℝ) 3).2.2 post3_0 := by
  rw [xg_3]
  constructor <;> intro q hq a u <;> interval_cases q <;> fin_cases a <;> cases u <;> norm_num [xgN, gtab, slot4, acap, f0, post3_0]

theorem maxp3_0 : ∀ q < 11, ∀ a u, post3_0 q a u ≤ vmax3 q a u := by
  intro q hq a u; interval_cases q <;> fin_cases a <;> cases u <;> norm_num [post3_0, vmax3]

