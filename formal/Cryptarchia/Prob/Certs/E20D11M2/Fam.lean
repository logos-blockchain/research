/-!
# E20D11M2: the band family

Generated by `tools/certgen/emitE.py`. Member `k` has honest exponent in
`[ysF k, ysF (k + 1)]` and adversarial exponent at most `β / (1 - β)` times the upper end; the kernel
computes its band (`memberOfQ`, `FamQ.lean`) and checks it.
-/

@[expose] public section

namespace Cryptarchia.Prob.Certs.E20D11M2

open Cryptarchia Cryptarchia.Prob

set_option maxRecDepth 100000
set_option maxHeartbeats 0


/-- The members' breakpoints. -/
def ysF : List ℚ :=
  [(30111159 / 1250000000 : ℚ), (245275884011 / 10000000000000 : ℚ), (249742376561 / 10000000000000 : ℚ), (127145102141 / 5000000000000 : ℚ), (64730212073 / 2500000000000 : ℚ), (131817908341 / 5000000000000 : ℚ), (134218322503 / 5000000000000 : ℚ), (273324896781 / 10000000000000 : ℚ), (278302163993 / 10000000000000 : ℚ), (14168503381 / 500000000000 : ℚ), (288530258159 / 10000000000000 : ℚ), (1836152601 / 62500000000 : ℚ), (14956712639 / 500000000000 : ℚ), (304581510333 / 10000000000000 : ℚ), (310127962861 / 10000000000000 : ℚ), (39471927089 / 1250000000000 : ℚ), (321525711129 / 10000000000000 : ℚ), (65476143769 / 2000000000000 : ℚ), (333342346699 / 10000000000000 : ℚ), (271530029 / 8000000000 : ℚ), (10799789513 / 312500000000 : ℚ), (351886544113 / 10000000000000 : ℚ), (358294424913 / 10000000000000 : ℚ), (364818993711 / 10000000000000 : ℚ), (92865593851 / 2500000000000 : ℚ), (75645346717 / 2000000000000 : ℚ), (96278567811 / 2500000000000 : ℚ), (392127231489 / 10000000000000 : ℚ), (199633949137 / 5000000000000 : ℚ), (406538597147 / 10000000000000 : ℚ), (6467839 / 156250000 : ℚ), (52684950731 / 1250000000000 : ℚ), (42915478161 / 1000000000000 : ℚ)]

/-- Member `k` over `ℚ`. -/
def famM (k : Fin 32) : MemberQ := memberOfQ (1 / 10 ^ 70) (1 / 10 ^ 16) (1 / 5 : ℚ) 13 12 ysF k.val

noncomputable def mem (k : Fin 32) : Member := (famM k).toMember

noncomputable def fam (k : Fin 32) : Band := (famM k).B.toBand

/-- The weakest band: weaker than every member. -/
noncomputable def B : Band where
  hhi := (2100608663387 / 50000000000000 : ℝ)
  hlo := (2378598482503 / 100000000000000 : ℝ)
  amax := (533579483037 / 50000000000000 : ℝ)
  hahi := (4483366738693 / 10000000000000000 : ℝ)
  slo := (2335519968001 / 100000000000000 : ℝ)
  hnlo := (118202887867 / 5000000000000 : ℝ)
  elo := (9477645737453 / 10000000000000 : ℝ)
  alo := (1528287063721 / 250000000000000 : ℝ)
  halo := (727036258119 / 5000000000000000 : ℝ)

def Bq : BandR := ⟨(2100608663387 / 50000000000000 : ℚ), (2378598482503 / 100000000000000 : ℚ), (533579483037 / 50000000000000 : ℚ), (4483366738693 / 10000000000000000 : ℚ), (2335519968001 / 100000000000000 : ℚ), (118202887867 / 5000000000000 : ℚ), (9477645737453 / 10000000000000 : ℚ), (1528287063721 / 250000000000000 : ℚ), (727036258119 / 5000000000000000 : ℚ)⟩

theorem B_eq : B = Bq.toBand := by
  simp only [B, Bq, BandR.toBand]; norm_num

/-- Every member's numeric conditions, and the weakest band below it. -/
theorem chkM : ∀ k, ((famM k).chk (1 / 10 ^ 70) (1 / 10 ^ 16) && Bq.weakerQ (famM k).B) = true := by
  decide +kernel

theorem chkM1 (k : Fin 32) : (famM k).chk (1 / 10 ^ 70) (1 / 10 ^ 16) = true := by
  have h := chkM k; simp only [Bool.and_eq_true] at h; exact h.1

theorem weak (k : Fin 32) : B.Weaker (fam k) := by
  have h := chkM k; simp only [Bool.and_eq_true] at h; rw [B_eq]; exact BandR.weaker_of h.2

theorem prod (k : Fin 32) : (fam k).Prod := memberOfQ_prod (chkM1 k)

theorem elo (k : Fin 32) : 0 ≤ (fam k).elo := memberOfQ_elo (chkM1 k)

theorem ok (k : Fin 32) : (mem k).OK (1 / 10 ^ 70) (1 / 10 ^ 16) := by
  have h := memberOfQ_OK (chkM1 k); push_cast at h; exact h

/-- The members' `slot4` fields over `ℚ`. -/
def famQ (k : Fin 32) : BandQ := (famM k).B.toQ

theorem famA (k : Fin 32) : (famQ k).Agrees (fam k) := (famM k).B.agrees

/-- The members' `slot4` fields' common denominator. -/
def DZ : ℤ := 10000000000000000

theorem DZ_pos : 0 < DZ := by decide

/-- The members' `slot4` fields over the integers, times `DZ`, computed once at elaboration time
(the index files read them); `famR` checks them against the bands. -/
def famZL : List (List ℤ) := eval% (List.finRange 32).map fun k => (famM k).B.toZList DZ

def famZ (k : Fin 32) : BandZ := BandZ.ofList (famZL.getD k.val [])

theorem famR : ∀ k, (famZ k).Rep DZ (famQ k) := by decide +kernel

/-- Each member's crossing bound. -/
def PatKQ (k : Fin 32) : ℚ := rdnQ 13 ((famM k).B.slo * (famM k).B.elo ^ 11)

theorem patm (k : Fin 32) : ((PatKQ k : ℚ) : ℝ) ≤ (fam k).slo * (fam k).elo ^ 11 := patQ_le 11 (famM k).B 13

