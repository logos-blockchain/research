theorem chkS17 : ∀ k, (autoSolZ (famZ k) DZ 11 X17 SZ vs17Z &&
    decide ((autoBoundZ (famZ k) DZ X17 SZ vs17Z : ℚ) ≤ eS17 k * (X17.M DZ * SZ : ℤ))) = true := by
  decide +kernel

