/-- Every check of member `k`, as one Boolean. -/
def chkE6Q (k : Fin 32) : Bool :=
  autoSolZ (famZ k) DZ 11 X6 SZ (post6Z k) && leTabZ 11 (post6Z k) vmax6Z &&
    preSolZ (famZ k) DZ 11 X6 SZ vmax6Z (pre6Z k) &&
    decide ((autoBoundZ (famZ k) DZ X6 SZ (post6Z k) : ℚ) ≤ eIn6 k * (X6.M DZ * SZ : ℤ)) &&
    decide ((autoBoundZ (famZ k) DZ X6 SZ (pre6Z k) : ℚ) ≤ (498340752287 / 500000000000 : ℚ) * (X6.M DZ * SZ : ℤ))

