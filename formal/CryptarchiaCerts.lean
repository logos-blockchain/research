module -- shake: keep-all

public import Cryptarchia.Claim.Finality
public import Cryptarchia.Prob.Certs.E20D11
public import Cryptarchia.Prob.Certs.E20D11G
public import Cryptarchia.Prob.Certs.E20D11C

/-!
# Cryptarchia: certified finality

The theorems below are instances of `Claim.Finality` (`Cryptarchia/Claim/Finality.lean`): at the
specification's parameters with security parameter `k`, network delay `Δ` slots and executions up
to slot `N`, under the execution model and the stake and chain-quality assumptions, a finality
violation has probability at most `ε`.

**To check what is proved, read this file, `Cryptarchia/Claim` and the specification
`Cryptarchia/Spec`, and nothing else.** The statements are written out here by hand, and Lean checks
that each certificate proves exactly that statement. `CryptarchiaTest/Claim.lean` checks that the
statements depend on no definition outside `Cryptarchia.Spec` and `Cryptarchia.Claim`;
`CryptarchiaTest/Axioms.lean` checks that the proofs use only Lean's standard axioms.

The proofs are certificates generated by `tools/certgen` (`Cryptarchia/Prob/Certs`). A certificate's
numbers enter only its proof: a wrong number makes a kernel check fail, it cannot change what is
proved. Building them takes about 20 min (`lake build CryptarchiaCerts`), most of it the two-month
certificate's tables (`Certs/E20D11G`), whose chunks build eight at a time.

All three are at the specification's parameters (f = 1/30, `Config.specK k`), with Δ = 11 slots,
the adversary holding at most β = 1/5 of the participating stake, stakes at most 10³⁰, the
canonical chain counting at least 87% of each window's honestly won slots (μ = 13/100), stake
drifting by at most a factor ρ = 101/100 per epoch, and honest online stake at least 10⁶.
-/

@[expose] public section

namespace Cryptarchia.Certified

/-- **Two months at k = 1000**: executions up to slot 5 184 000 (17 epochs of 300 000 slots),
failure probability at most 3.8 · 10⁻⁵. -/
theorem two_months :
    Claim.Finality
      (k := 1000)
      (Δ := 11)
      (N := 5184000)
      (β := 1 / 5)
      (Smax := 10 ^ 30)
      (μ := 13 / 100)
      (ρ := 101 / 100)
      (Hmin := 1000000)
      (ε := 3.8e-5) :=
  Prob.Certs.E20D11G.finality.mono (by norm_num)

/-- **A year at k = 2160**: executions up to slot 31 536 000, failure probability at most
7.2 · 10⁻¹¹. -/
theorem one_year :
    Claim.Finality
      (k := 2160)
      (Δ := 11)
      (N := 31536000)
      (β := 1 / 5)
      (Smax := 10 ^ 30)
      (μ := 13 / 100)
      (ρ := 101 / 100)
      (Hmin := 1000000)
      (ε := 7.2e-11) :=
  Prob.Certs.E20D11.finality.mono (by norm_num)

/-- **Every depth `k ≥ 1000` and every horizon `N`**: with `t = k / 20` and `N / (300 k) + 2`
epochs, failure probability at most
`(N + 18 t + 640) · (2.5 · 10⁻²⁵ + 0.5816 · 0.702021ᵗ) + (N / (300 k) + 2) · 1.562 · 0.745235ᵗ`.
Each 20 blocks of depth multiply the settlement term by 0.702 and the stake estimate's term by
0.745. At k = 2160 it is about 4.7 · 10⁻¹⁰ for a year. -/
theorem closed (k N : ℕ) (hk : 1000 ≤ k) :
    Claim.Finality
      (k := k)
      (Δ := 11)
      (N := N)
      (β := 1 / 5)
      (Smax := 10 ^ 30)
      (μ := 13 / 100)
      (ρ := 101 / 100)
      (Hmin := 1000000)
      (ε := ((N : ℝ) + 18 * ((k / 20 : ℕ) : ℝ) + 640) * (2.5e-25 + 0.5816 * 0.702021 ^ (k / 20)) +
        ((N / (300 * k) + 2 : ℕ) : ℝ) * (1.562 * 0.745235 ^ (k / 20))) :=
  Prob.Certs.E20D11C.finality_closed_short k N hk

end Cryptarchia.Certified
